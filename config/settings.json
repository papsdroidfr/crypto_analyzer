{
  "_comment": "Configuration CryptoAnalyzer — éditez ce fichier pour personnaliser le comportement.",

  "symbols": [
    "BTCUSDC",
    "ETHUSDC",
    "SOLUSDC",
    "TAOUSDC",
    "BNBUSDC"
  ],

  "timeframes": [
    {
      "value": "1h",
      "label": "1 heure",
      "candles_chart": 48
    },
    {
      "value": "1d",
      "label": "24 heures",
      "candles_chart": 60
    },
    {
      "value": "1w",
      "label": "1 semaine",
      "candles_chart": 26
    }
  ],

  "charts_output_dir": "charts_output",

  "discord": {
    "webhook_url": "MON WEBHOOK DISCORD ICI",
    "username": "CryptoAnalyzer 🤖"
  },

  "hourly_variation": {
    "threshold_pct": 2.0,
    "severity": "WARNING"
  },

  "alerts": [
    {
      "_comment": "RSI 7 en surachat extrême (> 80) — signal fort",
      "name": "rsi7_extreme_overbought",
      "type": "threshold",
      "timeframes": [
        "1d"
      ],
      "lookback_periods": 2,
      "severity": "WARNING",
      "message_tpl": "🚨 RSI_7 surachat extrême sur {symbol} [{tf}] — RSI = {rsi_7}",
      "conditions": [
        {
          "indicator": "rsi_7",
          "operator": ">",
          "value": 80,
          "agg": "min"
        }
      ]
    },

    {
      "_comment": "RSI 7 en survente extrême (< 20) — signal fort",
      "name": "rsi7_extreme_oversold",
      "type": "threshold",
      "timeframes": [
        "1d"
      ],
      "lookback_periods": 2,
      "severity": "WARNING",
      "message_tpl": "🚨 RSI_7 survente extrême sur {symbol} [{tf}] — RSI = {rsi_7}",
      "conditions": [
        {
          "indicator": "rsi_7",
          "operator": "<",
          "value": 20,
          "agg": "min"
        }
      ]
    },

    {
      "_comment": "Compression de Bollinger (faible volatilité, breakout imminent)",
      "name": "bollinger_squeeze",
      "type": "threshold",
      "timeframes": [
        "1d"
      ],
      "lookback_periods": 1,
      "severity": "INFO",
      "message_tpl": "🔀 Compression Bollinger sur {symbol} [{tf}] — Width={bb_width}",
      "conditions": [
        {
          "indicator": "bb_width",
          "operator": "<",
          "value": 0.05,
          "agg": "last"
        }
      ]
    },


    {
      "name": "bollinger_bounce",
      "type": "threshold",
      "timeframes": ["1d"],
      "severity": "CRITICAL",
      "message_tpl": "⚡️ Rebond sur la bande de Bollinger inférieure sur {symbol} [{tf}] — Close={close}, BB_Lower={bb_lower}",
      "conditions": [
        {
          "left": { "indicator": "close", "offset": 1 },
          "operator": "<",
          "right": { "indicator": "bb_lower", "offset": 1 }
        },
        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": ">",
          "right": { "indicator": "bb_lower", "offset": 0 }
        },
        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": ">",
          "right": { "indicator": "close", "offset": 1 }
        }
      ]
    }
  ]
}
