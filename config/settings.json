{
  "_comment": "Configuration CryptoAnalyzer — éditez ce fichier pour personnaliser le comportement.",

  "symbols": [
    "BTCUSDC",
    "ETHUSDC",
    "TAOUSDC",
    "NEARUSDC",
    "BNBUSDC",
    "HYPEUSDC"
  ],

  "timeframes": [
    {
      "value": "1h",
      "label": "1 heure",
      "candles_chart": 48
    },
    {
      "value": "1d",
      "label": "24 heures",
      "candles_chart": 60
    },
    {
      "value": "1w",
      "label": "1 semaine",
      "candles_chart": 26
    }
  ],

  "charts_output_dir": "charts_output",

  "discord": {
    "webhook_urls": {
      "daily": "WEBHOOK DISCORD DAILY ICI",
      "hourly": "WEBHOOK DISCORD HOURLY ICI",
      "weekly": "WEBHOOK DISCORD WEEKLY ICI"
    },
    "bot_token": "MON TOKEN BOT DISCORD ICI",
    "username": "CryptoAnalyzer 🤖",
    "channel_ids": {
      "daily": "ID CHANNEL DISCORD DAILY ICI",
      "hourly": "ID CHANNEL DISCORD HOURLY ICI",
      "weekly": "ID CHANNEL DISCORD WEEKLY ICI"
    }
  },
  

  "alert_hourly": [
    {
      "_comment": "Variation absolue du cours entre les deux dernières bougies horaires",
      "id": "HVARIATION",
      "name": "hourly_variation",
      "type": "hourly_variation",
      "timeframes": ["1h"],
      "threshold_pct": 2.0,
      "severity": "WARNING",
      "message_tpl": "Variation horaire de {variation_pct}% sur {symbol} [{tf}] (seuil {threshold_pct}%)"
    }
  ],

  "alert_weekly": [
    {
      "_comment": "LONG orientation haussière — MACD croise à la hausse et bougie hebdomadaire haussière",
      "id": "WLMACDUP",
      "name": "weekly_macd_bullish_candle",
      "type": "threshold",
      "timeframes": ["1w"],
      "severity": "WARNING",
      "message_tpl": "📈 Signal LONG hebdomadaire sur {symbol} [{tf}] — close={close}, open={open}",
      "conditions": [
        {
          "left": {"indicator": "macd_hist", "offset": 0},
          "operator": ">",
          "right": {"indicator": "macd_hist", "offset": 1}
        },
        {
          "left": {"indicator": "close", "offset": 0},
          "operator": ">",
          "right": {"indicator": "open", "offset": 0}
        }
      ]
    },
    {
      "_comment": "SHORT orientation baissière — MACD croise à la baisse et bougie hebdomadaire baissière",
      "id": "WSMACDDN",
      "name": "weekly_macd_bearish_candle",
      "type": "threshold",
      "timeframes": ["1w"],
      "severity": "WARNING",
      "message_tpl": "📉 Signal SHORT hebdomadaire sur {symbol} [{tf}] — close={close}, open={open}",
      "conditions": [
        {
          "left": {"indicator": "macd_hist", "offset": 0},
          "operator": "<",
          "right": {"indicator": "macd_hist", "offset": 1}
        },
        {
          "left": {"indicator": "close", "offset": 0},
          "operator": "<",
          "right": {"indicator": "open", "offset": 0}
        }
      ]
    }
  ],

  "alert_daily": [
    {
      "_comment": "RSI 7 en surachat extrême (> 80) — signal fort",
      "id": "DRSI7OB",
      "name": "rsi7_extreme_overbought",
      "type": "threshold",
      "timeframes": [
        "1d"
      ],
      "lookback_periods": 2,
      "severity": "WARNING",
      "message_tpl": "🚨 RSI_7 surachat extrême sur {symbol} [{tf}] — RSI = {rsi_7}",
      "conditions": [
        {
          "indicator": "rsi_7",
          "operator": ">",
          "value": 80,
          "agg": "min"
        }
      ]
    },

    {
      "_comment": "RSI 7 en survente extrême (< 20) — signal fort",
      "id": "DRSI7OS",
      "name": "rsi7_extreme_oversold",
      "type": "threshold",
      "timeframes": [
        "1d"
      ],
      "lookback_periods": 2,
      "severity": "WARNING",
      "message_tpl": "🚨 RSI_7 survente extrême sur {symbol} [{tf}] — RSI = {rsi_7}",
      "conditions": [
        {
          "indicator": "rsi_7",
          "operator": "<",
          "value": 20,
          "agg": "max"
        }
      ]
    },


    {
      "name": "bollinger rebond basse",
      "id": "DBBREBLO",
      "type": "threshold",
      "timeframes": ["1d"],
      "severity": "CRITICAL",
      "message_tpl": "⚡️ Rebond sur la bande de Bollinger inférieure sur {symbol} [{tf}] — Close={close}, BB_Lower={bb_lower}",
      "conditions": [
        {
          "left": { "indicator": "low", "offset": 2 },
          "operator": "<",
          "right": { "indicator": "bb_lower", "offset": 2 }
        },
        {
          "left": { "indicator": "close", "offset": 1 },
          "operator": ">",
          "right": { "indicator": "bb_lower", "offset": 1 }
        },
        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": ">",
          "right": { "indicator": "bb_lower", "offset": 0 }
        },

        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": ">",
          "right": { "indicator": "close", "offset": 1 }
        }
      ]
    },

    {
      "name": "bollinger rebond haute",
      "id": "DBBREBHI",
      "type": "threshold",
      "timeframes": ["1d"],
      "severity": "CRITICAL",
      "message_tpl": "⚡️ Rebond sur la bande de Bollinger supérieure sur {symbol} [{tf}] — Close={close}, BB_Upper={bb_upper}",
      "conditions": [
        {
          "left": { "indicator": "high", "offset": 2 },
          "operator": ">",
          "right": { "indicator": "bb_upper", "offset": 2 }
        },
        {
          "left": { "indicator": "close", "offset": 1 },
          "operator": "<",
          "right": { "indicator": "bb_upper", "offset": 1 }
        },
        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": "<",
          "right": { "indicator": "bb_upper", "offset": 0 }
        },
        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": "<",
          "right": { "indicator": "close", "offset": 1 }
        }
      ]
    },

    {
      "name": "Price crossed below EMA 50" ,
      "id": "DEMA50DN",
      "type": "threshold",  
      "timeframes": ["1d"],
      "severity": "CRITICAL",
      "message_tpl": "⚡️ Le prix a croisé en dessous de l'EMA 50 sur {symbol} [{tf}] — Close={close}, EMA_50={sma_50}",
      "conditions": [
        {
          "left": { "indicator": "close", "offset": 1 },
          "operator": ">",
          "right": { "indicator": "sma_50", "offset": 1 }
        },
        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": "<",      
          "right": { "indicator": "sma_50", "offset": 0 }
        }   
      ]
    },
    
    {
      "name": "Price crossed above EMA 50" ,
      "id": "DEMA50UP",
      "type": "threshold",  
      "timeframes": ["1d"],
      "severity": "CRITICAL",
      "message_tpl": "⚡️ Le prix a croisé au-dessus de l'EMA 50 sur {symbol} [{tf}] — Close={close}, EMA_50={sma_50}",
      "conditions": [
        {
          "left": { "indicator": "close", "offset": 1 },
          "operator": "<",
          "right": { "indicator": "sma_50", "offset": 1 }
        },
        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": ">",
          "right": { "indicator": "sma_50", "offset": 0 }
        }   
      ]
    },
    {
      "_comment": "Tendance haussière — MACD histogramme en hausse, RSI 7 sous 60 et cours sous la Bollinger supérieure",
      "name": "daily_bullish_macd_rsi_bollinger",
      "id": "DBULLMACD",
      "type": "threshold",
      "timeframes": ["1d"],
      "severity": "WARNING",
      "message_tpl": "📈 Tendance haussière sur {symbol} [{tf}] — MACD hist={macd_hist}, RSI 7={rsi_7}, close={close}, BB sup={bb_upper}",
      "conditions": [
        {
          "left": { "indicator": "macd_hist", "offset": 0 },
          "operator": ">",
          "right": { "indicator": "macd_hist", "offset": 1 }
        },
        {
          "left": { "indicator": "rsi_7", "offset": 0 },
          "operator": "<",
          "right": { "value": 60 }
        },
        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": "<",
          "right": { "indicator": "bb_upper", "offset": 0 }
        }
      ]
    },
    {
      "_comment": "Tendance baissière — MACD histogramme en baisse, RSI 7 au-dessus de 60 et cours au-dessus de la Bollinger supérieure",
      "name": "daily_bearish_macd_rsi_bollinger",
      "id": "DBEARMACD",
      "type": "threshold",
      "timeframes": ["1d"],
      "severity": "WARNING",
      "message_tpl": "📉 Tendance baissière sur {symbol} [{tf}] — MACD hist={macd_hist}, RSI 7={rsi_7}, close={close}, BB sup={bb_upper}",
      "conditions": [
        {
          "left": { "indicator": "macd_hist", "offset": 0 },
          "operator": "<",
          "right": { "indicator": "macd_hist", "offset": 1 }
        },
        {
          "left": { "indicator": "rsi_7", "offset": 0 },
          "operator": ">",
          "right": { "value": 40 }
        },
        {
          "left": { "indicator": "close", "offset": 0 },
          "operator": ">",
          "right": { "indicator": "bb_upper", "offset": 0 }
        }
      ]
    }
  ]
}
